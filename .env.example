# Host/IP di mana aplikasi berjalan (ganti ke IP server jika deploy ke VPS)
# contoh: APP_HOST=10.122.123.1
APP_HOST=localhost

# ===== Runtime umum =====
# Port backend API.
PORT=3000

# Secret JWT untuk autentikasi session.
JWT_SECRET=replace-me-with-a-strong-secret

# Mode autentikasi.
# local = login lokal untuk development/testing
# ldap = login via Active Directory untuk production
AUTH_MODE=local

# ===== Frontend origin =====
# Dipakai backend untuk CORS.
FRONTEND_ORIGINS=http://localhost:5173

# ===== Redis =====
# URL Redis bila tersedia.
REDIS_URL=redis://localhost:6379

# ===== SQL Server =====
# Connection string SQL Server untuk production.
# DATABASE_URL=sqlserver://user:password@server:1433;database=smartopex;encrypt=true;trustServerCertificate=true

# ===== LDAP =====
# Dipakai hanya saat AUTH_MODE=ldap.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ===== OCR =====
# Opsional override interpreter OCR.
# Kosongkan untuk memakai default container atau interpreter lokal.
# OCR_PYTHON=/opt/venv/bin/python