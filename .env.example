# Host/IP di mana aplikasi berjalan (ganti ke IP server jika deploy ke VPS)
# contoh: APP_HOST=10.122.123.1
APP_HOST=localhost

# ===== Runtime umum =====
# Port backend API.
PORT=3000

# Secret JWT untuk autentikasi session.
JWT_SECRET=replace-me-with-a-strong-secret

# Mode autentikasi.
# local = login lokal untuk development/testing
# ldap = login via Active Directory untuk production
AUTH_MODE=local

# Daftar email yang tetap boleh login lokal meskipun AUTH_MODE=ldap.
# Contoh seed account pusat.
LOCAL_AUTH_EMAILS=pusat@smartopex.local

# ===== Frontend origin =====
# Dipakai backend untuk CORS.
FRONTEND_ORIGINS=http://localhost:5173

# ===== Redis =====
# URL Redis bila tersedia.
REDIS_URL=redis://localhost:6379

# ===== SQL Server =====
# Connection string SQL Server untuk production.
# Prisma format:
# DATABASE_URL=sqlserver://server:1433;database=smartopex;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true

# ===== Data migration utilities =====
# Dipakai script migrasi data PostgreSQL -> SQL Server.
# PG_SOURCE_URL=postgresql://user:password@source-host:5432/smartopex
# MSSQL_TARGET_URL dapat memakai salah satu format berikut:
# 1) sqlserver://target-host:1433;database=smartopex;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true
# 2) mssql://sa:replace-me@target-host:1433/smartopex?encrypt=true&trustServerCertificate=true
# MIGRATION_TRUNCATE_BEFORE_LOAD=true
# MIGRATION_ALLOW_DESTRUCTIVE=false
# MIGRATION_DRY_RUN=true
# MIGRATION_CHUNK_SIZE=200
# MIGRATION_REPORT_PATH=backend/reports/migration-report.json
# MIGRATION_VALIDATION_REPORT_PATH=backend/reports/migration-validation-report.json

# ===== LDAP =====
# Dipakai hanya saat AUTH_MODE=ldap.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ===== OCR =====
# Opsional override interpreter OCR.
# Kosongkan untuk memakai default container atau interpreter lokal.
# OCR_PYTHON=/opt/venv/bin/python